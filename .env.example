# ─────────────────────────────────────────────────────────────
# InkShelf environment variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (optional but required for accounts, favorites,
# and reading shelves). Without it the app runs in "browse-only" mode and
# persistence features degrade gracefully.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/inkshelf
MONGODB_URI=

# NextAuth — required.
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — enables "Continue with Google").
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_ID=
GOOGLE_SECRET=

# Google AI Studio / Gemini API Key (required for AI book summaries)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: pin a specific Gemini model (defaults to gemini-flash-latest)
GEMINI_MODEL=

# Google Books API key (optional — raises the anonymous rate limit).
# Exposed to the browser, so restrict it by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Shared cache + rate limiting across server instances (optional, recommended in production).
# Free Redis database at https://upstash.com — copy the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password reset emails (optional). Without these, reset links are printed to the
# dev server terminal in development. Get a key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM="InkShelf <no-reply@yourdomain.com>"
